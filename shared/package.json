{
  "name": "@haalving/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RBAC, pure domain logic, Zod schemas and design tokens shared by the API, the console and the client app.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rbac": "./src/rbac.ts",
    "./pillars": "./src/pillars.ts",
    "./plans": "./src/plans.ts",
    "./cycle": "./src/cycle.ts",
    "./conflicts": "./src/conflicts.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tailwind-preset": "./src/tokens/tailwind-preset.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
