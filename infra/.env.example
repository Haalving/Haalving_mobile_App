# Host ports for the local containers. Defaults are the standard ones; override
# them when something else on your machine already listens there.
#
# The symptom you are avoiding: a local PostgreSQL service holding 5432 answers
# instead of the container, and Prisma reports "Authentication failed" — which
# reads as a wrong password rather than a wrong server.
#
#   netstat -ano | grep ":5432"        (Windows)
#   lsof -i :5432                      (macOS / Linux)
#
# Copy to infra/.env and edit. Keep DATABASE_URL / REDIS_URL in backend/.env in
# step with whatever you set here.
POSTGRES_PORT=5432
REDIS_PORT=6379
