{
  "expo": {
    "name": "HAALVING",
    "slug": "haalving",
    "owner": "pawansk",
    "scheme": "haalving",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D1211"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.haalving.app",
      "infoPlist": {
        "NSCameraUsageDescription": "HAALVING uses the camera to photograph your plate for your dietitian."
      }
    },
    "android": {
      "package": "com.haalving.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B5350"
      },
      "backgroundColor": "#0D1211"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "HAALVING uses the camera to photograph your plate for your dietitian."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f03ab808-3e47-4174-830d-5b7decb5ede9"
      }
    },
    "backgroundColor": "#0D1211"
  }
}
