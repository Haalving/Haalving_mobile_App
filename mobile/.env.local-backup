# On a clean machine the API is on 4000. This machine already runs another app
# there, so it is 4001 — see docs/DAY1.md.
#
# A device on the same Wi-Fi cannot reach "localhost" — that is the phone
# itself. Use the workstation's LAN address, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.13.164:4001/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:4001/api/v1

# Shows the backend-address field on the sign-in screen in a RELEASE build.
# This laptop's LAN address has changed on every new network, and the address is
# compiled in — without this field a moved laptop means a full rebuild instead of
# retyping one line on the phone. Internal test builds only.
EXPO_PUBLIC_DEV_TOOLS=1
