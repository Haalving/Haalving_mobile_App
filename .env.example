# ============================================================================
# HAALVING — environment template
#
# Copy the three blocks below into three files:
#   backend/.env        the block marked  [backend/.env]
#   web/.env.local      the block marked  [web/.env.local]
#   mobile/.env         the block marked  [mobile/.env]
#
# Nothing in this repository may hard-code a URL, key or password.
# backend/src/config/env.ts validates every backend key at startup and exits
# naming the first one that is missing or malformed.
# ============================================================================

# ---------------------------------------------------------- [backend/.env]
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata
# --- the two services you supply -------------------------------------------
# There is NO container setup in this repo. Both of these point at
# infrastructure you already run:
#
#   DATABASE_URL  your own PostgreSQL. Use a database this project OWNS — it is
#                 the target of `prisma migrate reset`, which DROPS AND RECREATES
#                 it. Pointing it at a database another app uses will destroy
#                 that app's data. Either scheme is accepted.
#
#   REDIS_URL     a hosted Redis. It holds only rate-limit counters and the OTP
#                 throttle, so a small shared instance is plenty. Use `rediss://`
#                 where the provider offers TLS.
#
# Set the server's timezone to Asia/Kolkata, or leave TZ below to do it for the
# API: every clock rule in the product (cycle day, quiet hours 22:00-07:00, the
# SLA ladder) is a LOCAL-time rule.
#
# Check both before touching the schema:
#   pnpm --filter @haalving/backend check
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
REDIS_URL=redis://default:PASSWORD@HOST:PORT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
WEB_ORIGIN=http://localhost:3000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=haalving-media
R2_PUBLIC_URL=
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
# --- development-only routes ------------------------------------------------
# NODE_ENV defaults to development, so a deployment that forgets to set it would
# register POST /auth/client/otp/dev-code — a route that hands back a live
# one-time code for ANY client number. env.ts therefore also looks at where it
# is running: when a hosting-platform variable (RAILWAY_*, RENDER, FLY_APP_NAME,
# KUBERNETES_SERVICE_HOST, ...) is present, or DATABASE_URL points at a
# host other than localhost (the host Prisma will use — a `?host=` parameter
# outranks the one before the port), the development-only routes stay OFF and a
# warning is written at boot. The line below re-opens them, and is for one case
# only — a machine you know is a development box that happens to use a hosted
# database. It is ignored where a hosting-platform variable is present: the platform's
# own word on where the process runs outranks it. Leave it commented out
# everywhere else: it is ignored in production too, and any value other than
# `allow` is a startup failure.
# HV_DEV_ROUTES=allow

# ------------------------------------------------------- [web/.env.local]
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------- [mobile/.env]
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
