// HAALVING — database schema.
//
// Model names follow the demo's store keys so a reader can hold both in their
// head at once: `users` -> User, `clients` -> Client, `capacity` -> Capacity.
//
// THE VOCABULARY RULE, restated here because this is where it would be easiest
// to "tidy up" and break the product: pillar keys are fitness / culture / yoga /
// wellness, and the STAFF ROLE keys for the same four pillars are fitness /
// dietitian / yoga / mind. `culture` displays as "Nutrition" and `wellness` as
// "Mind Wellness". Nothing here renames either set.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- vocabulary

/// The eleven roles a real user record may carry.
///
/// The RBAC matrix in @haalving/shared has TWELVE — `ai` is a pseudo-role that
/// `HV.staff()` invents for any id it does not know, so an unfilled pillar seat
/// renders as the AI without special-casing. No stored user carries it, and one
/// that did would sign house content "AI Coach" — a lie, and a breach of the rule
/// that a Poorna client never hears the AI.
enum UserRole {
  client
  admin
  opsmgr
  opshead
  core
  doctor
  dietitian
  fitness
  yoga
  mind
  hod
}

enum UserStatus {
  active
  inactive
}

/// Mapped to the lowercase keys the API and both frontends speak. The enum
/// members are uppercase by Prisma convention; the stored value is the key.
enum Plan {
  POORNA @map("poorna")
  SVAYAM @map("svayam")
}

/// The demo's own three, verbatim (console-clients.js STATUS_FILTERS).
/// "inactive", not "ended": a lapsed term is a win-back call waiting to be made,
/// not a closed record, and the console's filter rail says so.
enum ClientStatus {
  active
  paused
  inactive
}

enum Sex {
  M
  F
}

/// The activity category. It is not merely a catalogue filter — it indexes the
/// level books and the level-review criteria, and a category with no book of its
/// own falls back to Sedentary.
enum Track {
  sedentary
  moderate
  active
}

/// The four coach benches. `null` for the ops and medical seats, which belong to
/// no department.
enum Dept {
  dietitian
  fitness
  yoga
  mind
}

/// A seat on a client's pod, keyed by STAFF ROLE — `dietitian`, not `culture`;
/// `mind`, not `wellness`. Both the cover-aware seat resolver and client scoping
/// look a seat up by role key, so renaming either would break every coach's
/// client list.
enum PodSeatKey {
  dietitian
  fitness
  yoga
  mind
  doctor
  admin
  opshead
}

/// How much attention a client needs. NOT derived — a coach or the digest sets
/// it, and `riskWhy` says at what. The two always travel together: the red edge
/// says look, the reason says where.
enum Risk {
  low
  medium
  high
}

/// How loud a digest line is. The demo's two, and ABSENT is the third state:
/// an unflagged line still gets printed — "no action needed" is worth saying.
enum DigestFlag {
  HIGH @map("high")
  MED  @map("med")
}

// -------------------------------------------------------------------- access

/// The RBAC matrix, in the database.
///
/// It is seeded from @haalving/shared/rbac.ts and Configuration edits it at
/// runtime — the demo does exactly this (`HV.roleDef` reads the store first and
/// falls back to the code matrix), which is what lets a role gain a page by
/// ticking a nav box. The shared matrix stays the seed and the fallback.
model Role {
  key   String   @id
  title String
  shell String
  home  String
  /// Sidebar item ids, IN ORDER. The order is the sidebar's order and is never
  /// re-sorted on read.
  nav   String[]
  perms String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id                 String     @id @default(cuid())
  /// Staff sign in with this. A client record may carry one for correspondence.
  email              String?    @unique
  /// E.164. A client signs in with this and a one-time code.
  phone              String?    @unique
  /// Null for a client — they have no password, only the OTP door.
  passwordHash       String?
  role               UserRole
  name               String
  /// The demo's `memo`: one line on the person.
  subtitle           String?
  /// Which of the four benches. Required for `hod`, whose entire scope is it.
  dept               Dept?
  /// 1 = senior. The cover board reaches for an L2 when an L1 is away.
  level              Int?
  joinedAt           DateTime?
  /// Declared working hours per weekday. ONE range or SEVERAL:
  ///   { "mon": ["09:00","17:00"] }
  ///   { "mon": [["06:00","10:00"],["17:00","21:00"]] }   a split shift
  ///   { "sun": null }                                    off
  /// Read only through `availWindows()` — every helper that indexed [0]/[1]
  /// directly returned nothing for a split shift, silently.
  avail              Json       @default("{}")
  tz                 String     @default("Asia/Kolkata")
  /// Hours offset used to restate an IST time in this person's own clock.
  tzo                Float      @default(5.5)
  tzLabel            String     @default("IST")
  /// { name, phone }
  emergency          Json?
  /// Typed tags only. The record derives its own (New joinee, On leave, ...).
  tags               String[]   @default([])
  /// The CV in object storage. `cv` holds the KEY; `cvName` the filename a human
  /// recognises, because an R2 key is a uuid and "Vikram-CV-2026.pdf" is not.
  cv                 String?
  cvName             String?
  /// The Super Admin's private note. Distinct from `subtitle`, which everybody
  /// with the page reads — only `managePeople` is ever shown this.
  memo               String?
  /// When they were switched off, kept for the audit trail. `status` says
  /// whether; this says when, and the pair is what a reinstatement reads.
  deactivatedAt      DateTime?
  /// A freshly created account signs in with a one-time password and is made to
  /// replace it. The flag is on the USER rather than on the session, so it
  /// survives them closing the tab before they get round to it.
  mustChangePassword Boolean    @default(false)
  status             UserStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile Client?        @relation("ClientLogin")
  podSeats      PodSeat[]      @relation("PodSeatStaff")
  capacity      Capacity?
  refreshTokens RefreshToken[]
  auditActions  AuditLog[]     @relation("AuditActor")
  homeSeen      HomeSeen[]

  arrivalsCreated   Arrival[]            @relation("ArrivalCreatedBy")
  arrivalEvents     ArrivalEvent[]       @relation("ArrivalEventActor")
  leaves            Leave[]              @relation("LeaveApplicant")
  leaveEvents       LeaveEvent[]         @relation("LeaveEventActor")
  leaveResponses    LeaveCoverResponse[] @relation("LeaveCoverResponder")
  reallocationsTo   LeaveReallocation[]  @relation("ReallocationCover")
  sessionCoversTo   LeaveSessionCover[]  @relation("SessionCover")
  podCovers         PodCover[]           @relation("PodCoverStaff")
  notices           Notice[]             @relation("NoticeRecipient")
  templatesAuthored PlanTemplate[]       @relation("TemplateAuthor")
  shapesAuthored    ProgramShape[]       @relation("ShapeAuthor")
  teamPosts         TeamPost[]           @relation("TeamPostAuthor")
  teamFeedRead      TeamFeedRead?

  tasksCreated         Task[]         @relation("TaskCreatedBy")
  gatheringsCreated  Gathering[] @relation("GatheringCreatedBy")
  gatheringsApproved Gathering[] @relation("GatheringApprovedBy")
  taskDones            TaskDone[]     @relation("TaskDoneBy")
  taskResponses        TaskResponse[] @relation("TaskResponder")
  taskProposals        TaskProposal[] @relation("TaskProposer")
  taskProposalsApplied TaskProposal[] @relation("TaskProposalApplier")

  circleMessages     CircleMessage[]     @relation("CircleMessageAuthor")
  followupsCreated   FollowupDraft[]     @relation("FollowupCreatedBy")
  followupsEdited    FollowupDraft[]     @relation("FollowupEditedBy")
  followupsApproved  FollowupDraft[]     @relation("FollowupApprovedBy")
  followupsSent      FollowupDraft[]     @relation("FollowupSentBy")
  followupsDismissed FollowupDismissal[] @relation("FollowupDismissedBy")

  worklistOwned   WorklistItem[]   @relation("WorklistOwner")
  worklistCleared WorklistItem[]   @relation("WorklistDoneBy")
  approvalsOwned  Approval[]       @relation("ApprovalOwner")
  approvalActs    ApprovalEvent[]  @relation("ApprovalEventActor")
  mealsRated      Meal[]           @relation("MealRater")
  summariesSigned MedicalSummary[] @relation("SummarySigner")

  communityPosts    CommunityPost[] @relation("CommunityPostAuthor")
  communityComments PostComment[]   @relation("PostCommentAuthor")
  zonesCreated      Zone[]          @relation("ZoneCreatedBy")
  broadcastsSent    Broadcast[]     @relation("BroadcastSender")

  @@index([role])
  @@index([dept])
  @@index([status])
  @@map("users")
}

// -------------------------------------------------------------------- clients

model Client {
  id     String  @id @default(cuid())
  /// The client's login, when they have one. Two demo records deliberately have
  /// none: console-side clients with no app and no thread. Nothing may post into
  /// a room nobody can open, so several features filter on this being present.
  userId String? @unique
  user   User?   @relation("ClientLogin", fields: [userId], references: [id], onDelete: SetNull)

  name        String
  code        String? @unique
  designation String?

  // -- clinical. `sex` chooses the lab reference bands and feeds the BMR
  //    formula; it is NOT the same field as `gender`, and merging the two
  //    silently moves a client's reference bands.
  /// NULLABLE since onboarding (28 Aug 2026). An arrival does not record sex, so
  /// a client minted by promotion genuinely does not have one yet. The demo hid
  /// this by cloning a donor client, which meant every new client silently
  /// inherited a stranger's — the exact failure the promotion contract exists to
  /// prevent. Unknown is null, and null is honest.
  sex      Sex?
  dob      DateTime?
  heightCm Float?
  weightKg Float?
  health   String[]  @default([])

  // -- identity, deliberately separate from the clinical fields above.
  gender   String?
  /// How this person asked to be addressed, e.g. "he/him".
  address  String?
  location String?
  email    String?
  phone    String?

  plan         Plan     @default(POORNA)
  /// Which pillars a HUMAN carries. Poorna is all four by definition; this only
  /// ever narrows a Svayam client. PILLAR keys: fitness, culture, yoga, wellness.
  humanPillars String[] @default([])
  tier         String?

  /// Which cycle they are in, and which day of it.
  cycle        Int           @default(1)
  cycleDay     Int           @default(1)
  /// The programme shape this client's CURRENT cycle started on. Set at
  /// promotion and, when the cycle engine lands, at every rollover — never
  /// mid-cycle.
  shapeVersion Int?
  shape        ProgramShape? @relation(fields: [shapeVersion], references: [version], onDelete: SetNull)
  /// The four pillar levels: { fitness, culture, yoga, wellness }.
  /// There is NO headline level — the four are the whole reading, and nothing
  /// may reduce them to one number.
  levels       Json          @default("{\"fitness\":1,\"culture\":1,\"yoga\":1,\"wellness\":1}")
  track        Track         @default(sedentary)
  /// Days 1-5, before level 1 begins. No ratings, no levels — only observation.
  observation  Boolean       @default(false)

  status    ClientStatus @default(active)
  statusWhy String?

  /// The ENGAGEMENT clock — what was paid for. A DIFFERENT clock from the
  /// programme's 7 x 14 days, and the two are never shown as one number.
  termDays  Int       @default(90)
  termStart DateTime?

  goal    String?
  purpose String?
  tzo     Float   @default(5.5)
  tzLabel String  @default("IST")

  /// The SECOND celebration date. `dob` alone gives birthdays and silently drops
  /// every anniversary from the celebrations strip.
  anniv DateTime?

  // -- what the roster cards read ------------------------------------------
  /// Set by a coach or the morning digest, never computed from activity.
  risk           Risk?
  /// What the risk is ABOUT. A flag with no reason is an alarm nobody can act on.
  riskWhy        String?
  /// Percent of the plan kept. NULL is meaningful and is not 0 — a client in
  /// their observation window has nothing to comply with yet.
  compliance     Int?
  /// The four-pillar reading from the cycle just closed:
  /// { fitness, culture, yoga, wellness }, each 0-100. This is the Index's
  /// ghost outline and what a level move is measured against.
  lastCycleIndex Json?
  /// The per-pillar session ledger, keyed by STAFF ROLE (`mind`, not `wellness`):
  ///   { fitness: {done,target,cancelled}, yoga: {...}, mind: {done,target} }
  /// `mind` carries no `cancelled` — one counselling a cycle is either held or
  /// it is not.
  sessions       Json?

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pod      PodSeat[]
  mealPlan MealPlan?
  /// The arrival this client was promoted from, when there was one. Clients
  /// created any other way simply have none.
  arrival  Arrival?
  digest   DigestEntry[]

  circleMessages     CircleMessage[]
  podCovers          PodCover[]
  leaveReallocations LeaveReallocation[]
  notices            Notice[]
  followupDrafts     FollowupDraft[]
  followupDismissals FollowupDismissal[]
  tasks              Task[]
  clientFlows        ClientFlow[]

  worklistItems    WorklistItem[]
  approvals        Approval[]
  meals            Meal[]
  medicalSummaries MedicalSummary[]
  deviations       Deviation[]

  communityMember     CommunityMember?
  communityPosts      CommunityPost[]
  postLikes           PostLike[]
  postComments        PostComment[]
  zoneMemberships     ZoneMember[]
  gatheringEnrolments GatheringEnrolment[]
  challengeEntries    ChallengeEntry[]
  gameAnswers         GameAnswer[]
  announcePref        ClientAnnouncePref?
  broadcastsReceived  BroadcastDelivery[]

  @@index([plan])
  @@index([status])
  @@map("clients")
}

/// One seat, one role, one client. `staffId: null` is a real value — it means the
/// AI holds the seat, which is the ordinary state for an unbought pillar on a
/// Svayam plan.
model PodSeat {
  id       String     @id @default(cuid())
  clientId String
  client   Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  seat     PodSeatKey @map("pillar_key")
  staffId  String?
  staff    User?      @relation("PodSeatStaff", fields: [staffId], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now())
  assignedBy String?

  @@unique([clientId, seat])
  @@index([staffId])
  @@map("pod_seats")
}

/// How many clients a coach carries.
///
/// DECLARED, NEVER DERIVED. Counting pod seats would make this a fact about the
/// database rather than a decision by whoever runs the bench — the demo's Vikram
/// reads 50/50 FULL while carrying six, and that is correct: his WEEK is full.
model Capacity {
  staffId  String  @id
  staff    User    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// The ceiling this coach is willing to carry.
  declared Int     @default(0)
  /// What they are carrying now. Stated, not counted.
  load     Int     @default(0)
  note     String?

  updatedAt DateTime @updatedAt

  @@map("capacity")
}

// --------------------------------------------------------------------- auth

/// Refresh tokens, rotated on every use.
///
/// `familyId` is the whole point: a rotation issues a new token in the same
/// family and revokes the old one. If a REVOKED token is ever presented again,
/// it was replayed — someone has a copy — so the entire family is revoked and
/// that session is dead everywhere. Only the hash is stored.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Set when this token was rotated, so a replay can name its successor.
  replacedBy String?
  userAgent  String?
  ip         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// One-time codes for the client app's phone login. Only the hash is stored, and
/// `attempts` is what stops a six-digit code being brute-forced in a loop.
model Otp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
  @@map("otps")
}

/// The audit trail.
///
/// Every refusal writes one, with action `denied` — the demo's lock screen says
/// "This access attempt was logged", and in production that has to be true rather
/// than reassuring. Every pod seat change, role change and capacity override
/// writes one too, so "who put Vikram on this client, and why" always has an
/// answer with a name on it.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  subjectType String
  subjectId   String?
  reason      String?
  meta        Json     @default("{}")
  ip          String?
  at          DateTime @default(now())

  @@index([actorId])
  @@index([subjectType, subjectId])
  @@index([at])
  @@map("audit_logs")
}

// ------------------------------------------------------------------- config
//
// Day 1 keeps these as typed rows with a Json body: the seed needs somewhere to
// put the demo's reference content, and modelling the catalogue properly is a
// later day's work with its own screens. The Json is a holding pen, not the
// destination.

/// The meal-reply SLA ladder. One row; `id` is fixed so it cannot multiply.
model SlaConfig {
  id               String @id @default("default")
  /// Minutes a plate may wait for a human rating.
  replyTargetMin   Int    @default(15)
  notifyAfterMin   Int    @default(10)
  escalateAfterMin Int    @default(15)
  escalateToRole   String @default("admin")

  updatedAt DateTime @updatedAt

  @@map("sla_config")
}

/// Notification rules, including the quiet-hours window (22:00-07:00) that the
/// automation sweeps honour.
model NotifRule {
  id       String  @id @default(cuid())
  title    String  @unique
  /// FREE TEXT. The jobs interpret the schedules they know and store the rest —
  /// a closed enum would mean a new cadence needed a deploy before Ops could
  /// even write it down.
  schedule String  @default("Daily")
  audience String  @default("All")
  channel  String  @default("Push")
  position Int     @default(0)
  detail   String?
  enabled  Boolean @default(true)
  body     Json    @default("{}")

  updatedAt DateTime @updatedAt

  @@map("notif_rules")
}

/// The five libraries: culture, fitness, yoga, wellness and motivation.
/// `motivation` is a template KIND and a library, still NOT a fifth pillar.
model CatalogItem {
  id       String  @id
  pillar   String
  kind     String
  name     String
  /// Everything else the item carries: media, nutrients, dose, instructions.
  body     Json    @default("{}")
  track    String?
  level    Int?
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pillar])
  @@map("catalog_items")
}

/// The teaching around a client's plate: per-slot targets, the fibre-protein-carb
/// order, the human-voiced swap line. The assigned template supplies WHAT and
/// WHEN; this supplies the teaching, matched by slot name.
model MealPlan {
  id       String  @id @default(cuid())
  clientId String? @unique
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title    String?
  body     Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meal_plans")
}

/// The morning digest — one line per client, why they need attention today and
/// the evidence behind it.
///
/// A TABLE rather than a field on Client, because it is a DATED reading rather
/// than a property of the person: the same client gets a new line tomorrow, and
/// the Attention tab wants the line, not the client.
model DigestEntry {
  id       String      @id @default(cuid())
  /// The digest DAY, not a timestamp — `@db.Date`, so "today's digest" is an
  /// equality test rather than a range, and one client cannot collect two lines
  /// for the same morning.
  date     DateTime    @db.Date
  clientId String
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// NULL is a real value and the commonest one: the client is fine, and the
  /// line is there to say so. Only HIGH and MED wear a pill.
  flag     DigestFlag?
  text     String
  /// Where the reading came from. The demo carries one string joined by ' · ';
  /// stored split, because it is a LIST — the row prints it joined and a later
  /// evidence viewer will want the parts.
  evidence String[]    @default([])
  /// Seed / rule order. The tab sorts by flag first and this second, so lines of
  /// equal loudness keep the order they were written in.
  position Int         @default(0)

  createdAt DateTime @default(now())

  /// One line per client per morning.
  @@unique([date, clientId])
  @@index([clientId])
  @@index([date])
  @@map("digest_entries")
}

/// What a person has already looked at, per Home tab.
///
/// SERVER-SIDE, per user, per tab — never localStorage. "New since you last
/// looked" is a fact about the person, not about the browser they happened to
/// open: marking something read on a laptop must not leave it bold on a phone.
///
/// `ids` is the exact list that was ON SCREEN when it was stamped, mirroring the
/// demo's `stampSeen`. Storing a timestamp instead would mark unseen anything
/// that arrived while the page was open.
model HomeSeen {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// attention | replies | followups | tasks | notices | sessions
  tabKey String
  ids    String[] @default([])

  updatedAt DateTime @updatedAt

  @@unique([userId, tabKey])
  @@map("home_seen")
}

/// The programme's shape, as one editable row: 7 levels x 14 days, review on day
/// 12, meeting on day 14, rest on 5 and 10. Config decides what gets BUILT; the
/// data decides what gets DRAWN, so a cycle already recorded at another length
/// keeps its own.
model ProgramShape {
  /// VERSIONED, not a singleton. The shape applies from each client's NEXT
  /// cycle, so an old row stays readable for everybody still mid-cycle on it —
  /// nothing recomputes under a client's feet. Highest version is current;
  /// `Client.shapeVersion` pins which each person is walking.
  id          String   @id @default(cuid())
  version     Int      @unique @default(autoincrement())
  levels      Int      @default(7)
  cycleDays   Int      @default(14)
  reviewDay   Int      @default(12)
  meetingDay  Int      @default(14)
  restDays    Int[]    @default([5, 10])
  termDays    Int      @default(90)
  sessions    Json     @default("{\"fitness\":5,\"yoga\":3,\"mind\":1}")
  createdById String?
  createdBy   User?    @relation("ShapeAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients Client[]

  @@map("program_shape")
}

/**
 * ═══════════════════════════ Care Circle ═══════════════════════════
 */

/// Who put a message in the circle.
///
/// `AI` exists so an AI-authored line can be STORED and told apart, never so the
/// AI can send one: `circle.service.postMessage` is the only writer and every
/// follow-up it posts carries a human `fromUserId`. The copilot drafts; a named
/// human sends.
enum MessageFromKind {
  STAFF
  CLIENT
  AI
}

/// The demo's four message kinds (`core.js` message shape).
/// `TEAMONLY` is visible to staff and never to the client.
enum MessageKind {
  TEXT
  TEAMONLY
  PROMO
  WISH
  /// A pinned card rather than a line of chat — the first thing promotion puts
  /// in a new client's room ("Welcome to HAALVING · How we'll work together").
  CARD
  /// The artifact a chain published — a chart, a diet plan, a calendar. The last
  /// signature drops it into the room like an attachment, which is the delivery
  /// step of the SOP (console-approvals.js:105) and the reason a chain exists at
  /// all: nothing reaches a client until somebody has signed for it.
  DOC
  /// The stars a dietitian confirmed on a plate, delivered into the room the
  /// moment they are given (console-meals.js:102). Its own kind rather than a
  /// TEXT line, because the client's room renders it as a rating card against
  /// the photo — and because a rating is the one message that must never be
  /// posted for a client still in their observation window.
  RATING
  /// The client's own line announcing a plate they logged ("Breakfast logged"),
  /// which the thread draws as a card with the photograph rather than as a
  /// sentence. Its own kind for the same reason RATING and DOC are: the three
  /// are what a room contains besides talk, and a reader that had to guess from
  /// the text which of them a line was would guess wrong the first time somebody
  /// typed the word "logged".
  MEAL
}

/// The minimal Care Circle: the room each client shares with their pod.
///
/// This table exists now because a follow-up has to LAND somewhere, and the
/// place it lands is the same room the wishes, the Replies tab and the mobile
/// coach chat will use. Writing it once, here, means those three inherit the
/// sequence, the authorship rule and the ordering rather than each inventing
/// their own.
///
/// Reads, unread counts and the chat UI are deliberately NOT built yet.
model CircleMessage {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// NULL means the message is not from a staff member — the client themselves,
  /// or an AI line. Read `fromKind` to tell which; a null author is never a bug.
  fromUserId String?
  fromUser   User?           @relation("CircleMessageAuthor", fields: [fromUserId], references: [id], onDelete: SetNull)
  fromKind   MessageFromKind

  kind MessageKind @default(TEXT)
  text String

  /// PER-CLIENT and monotonic, assigned inside the service under a transaction.
  ///
  /// The demo keeps ONE global counter (`HV.pushMsg`, core.js:1057) because a
  /// single browser store has only one writer. A server does not: a per-client
  /// sequence is what makes "message 4 in Rajesh's room" a stable, meaningful
  /// address, and it is what a paged reader and a read-receipt will both need.
  seq Int

  createdAt DateTime @default(now())

  followupDraft FollowupDraft?

  /// The announcement this card was, when it was one. Present so a re-seed can
  /// find its own broadcast output again and clear it without ever reaching a
  /// line a client wrote — the same route `followupDraft` gives the follow-ups
  /// seed.
  broadcastDelivery BroadcastDelivery?

  /// The room, in order — one constraint doing two jobs. The unique index it
  /// creates is also the index a paged reader wants, so no separate @@index.
  @@unique([clientId, seq])
  @@map("circle_messages")
}

/**
 * ═══════════════════════════ Follow-ups ═══════════════════════════
 */

/// Who wrote the draft. The two sources travel different roads: an AI draft may
/// be sent by anyone carrying the client, a coach draft needs an approver.
enum FollowupSource {
  AI
  COACH
}

/// DRAFT             an AI line, waiting for any scoped human to send it
/// PENDING_APPROVAL  a coach wrote it; only `sendDigest` can send it
/// RETURNED          an approver sent it back with a note; the author may edit
/// SENT              in the client's Care Circle, and final
/// DISMISSED         an AI line refused with a reason; never shown again
enum FollowupStatus {
  DRAFT
  PENDING_APPROVAL
  RETURNED
  SENT
  DISMISSED
}

/// The demo's five dismissal reasons, exactly (console-digest.js:647). The list
/// is closed on purpose: it is a training signal, and free text cannot be
/// counted.
enum DismissReason {
  ALREADY_HANDLED_IN_PERSON
  CLIENT_REACHED_OUT_FIRST
  NOT_THE_RIGHT_MOMENT
  TONE_NEEDS_REWORK
  DUPLICATE_NUDGE
}

/// A message someone means to send a client, before it is sent.
model FollowupDraft {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  text         String
  /// The words as first written, kept for the life of the row.
  ///
  /// The demo's own toast promises it — "Draft updated. Your edit is part of the
  /// record." — and the promise is only true if the thing edited FROM survives.
  /// Set once at creation and never written again.
  originalText String

  status FollowupStatus
  source FollowupSource

  /// NULL for an AI draft: nobody wrote it, which is the whole point of the
  /// review step in front of it.
  createdById String?
  createdBy   User?   @relation("FollowupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  editedById String?
  editedBy   User?     @relation("FollowupEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt   DateTime?

  /// The approver, recorded SEPARATELY from the author. A coach draft goes out
  /// under the coach's name; who cleared it is a different fact and the sent row
  /// says both.
  approvedById String?
  approvedBy   User?     @relation("FollowupApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  /// Why it came back. Cleared on resubmit, so a returned note never haunts a
  /// draft that has since been fixed.
  returnNote String?

  sentById String?
  sentBy   User?     @relation("FollowupSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt   DateTime?

  /// The message this became. One draft, one message.
  circleMessageId String?        @unique
  circleMessage   CircleMessage? @relation(fields: [circleMessageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  dismissal FollowupDismissal?

  @@index([clientId])
  @@index([status])
  @@index([createdById])
  @@map("followup_drafts")
}

/// A refused AI draft, and why.
///
/// ITS OWN TABLE, not an AuditLog row. The sheet promises "every dismissal is
/// logged so the copilot learns", which makes this training data rather than an
/// access record: it wants a closed reason enum, a per-reason count, and a life
/// independent of whatever retention the audit trail eventually gets.
model FollowupDismissal {
  id      String        @id @default(cuid())
  draftId String        @unique
  draft   FollowupDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  /// Denormalised from the draft so a per-client count survives the draft's
  /// deletion and needs no join.
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  reason DismissReason

  byId String?
  by   User?   @relation("FollowupDismissedBy", fields: [byId], references: [id], onDelete: SetNull)

  at DateTime @default(now())

  @@index([clientId])
  @@index([reason])
  @@map("followup_dismissals")
}

/**
 * ═══════════════════════════ Onboarding ═══════════════════════════
 */

/// Where an arrival came from.
enum ArrivalSource {
  SALES    @map("sales")
  SELF     @map("self")
  REFERRAL @map("referral")
}

/// ACTIVE    walking the twelve steps
/// PROMOTED  finished, and now a Client — the arrival stays as the record of how
/// WITHDRAWN stopped before the end; kept, because why somebody left is a fact
enum ArrivalStatus {
  ACTIVE
  PROMOTED
  WITHDRAWN
}

/// Every kind of thing that happens to an arrival, including the refusals.
///
/// DENIED is written on every 403 because the console promises the person who
/// tried that "This attempt was logged" — a promise the UI cannot keep on its own.
enum ArrivalEventKind {
  TICK
  UNTICK
  CLOSE_STEP
  STEP_BACK
  FIX_OPENED
  PLAN_SET
  NOTE
  ALLOCATED
  INBODY
  WELCOME
  PROMOTED
  DENIED
}

/// A person walking in, before they are a client.
///
/// ARRIVALS ARE NOT CLIENTS, and this table exists to stop the two being the same
/// row. The Day 1 port carried them as `PipelineCard` with a five-value `stage`
/// enum, which could not express the SOP's twelve steps and had no room for the
/// ticks, the seats or the InBody. Its five rows were migrated into this table
/// and it was dropped.
///
/// Closing the last step is the ONLY thing that turns an arrival into a client.
model Arrival {
  id    String  @id @default(cuid())
  name  String
  phone String?
  email String?

  plan   Plan          @default(POORNA)
  source ArrivalSource @default(SALES)
  note   String?

  /// When they walked in — what the header's "here 5 h" counts from.
  arrivedAt DateTime @default(now())

  /// A FLOW key, not an enum: the SOP is versioned and a Postgres enum cannot be
  /// re-ordered without a migration, while the flow itself must be free to gain a
  /// step. `flowVersion` below says which revision this record walked.
  step String @default("records")

  /// `{ "assessprep#3": true }` — keyed by STEP, so stepping back and forth never
  /// mixes two steps' progress.
  ticks Json @default("{}")

  /// How many of each step's tasks this record has been reckoned with, so a task
  /// the SOP gains later is backfilled instead of showing a phantom open item.
  /// See healTicks in @haalving/shared.
  healed Json @default("{}")

  flowVersion String

  /// `{ podSeatKey: staffId }`, filled during Team allocation and copied into real
  /// PodSeat rows at promotion. Held as Json until then because an arrival has no
  /// Client row for PodSeat to point at.
  podSeats Json @default("{}")

  /// `{ weightKg, heightCm, bodyFatPct, skeletalMuscleKg, visceralFat, keyedById, keyedAt }`
  inbody Json?

  welcomedAt  DateTime?
  welcomeText String?

  status ArrivalStatus @default(ACTIVE)

  /// The client this became. Set once, at promotion, and never cleared — it is
  /// how a client's record can always name the arrival it came from.
  promotedClientId String? @unique
  promotedClient   Client? @relation(fields: [promotedClientId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ArrivalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    ArrivalEvent[]

  @@index([status])
  @@index([step])
  @@map("arrivals")
}

/// Who did what to an arrival, in order.
///
/// Separate from AuditLog on purpose: this is the record the WORKSPACE reads —
/// the header's elapsed time, the event list, who ticked what — at one arrival's
/// granularity and with the step and task on the row. AuditLog stays the
/// console-wide access trail, and the two are written together where a refusal
/// needs to appear in both.
model ArrivalEvent {
  id        String  @id @default(cuid())
  arrivalId String
  arrival   Arrival @relation(fields: [arrivalId], references: [id], onDelete: Cascade)

  kind      ArrivalEventKind
  stepKey   String?
  taskIndex Int?

  byId String?
  by   User?   @relation("ArrivalEventActor", fields: [byId], references: [id], onDelete: SetNull)

  /// Whatever the kind needs: the seats allocated, the reason for a refusal, the
  /// plan that was set. Deliberately open — an event's payload is a fact about
  /// that event, not a column every other kind has to carry as null.
  meta Json @default("{}")

  at DateTime @default(now())

  @@index([arrivalId, at])
  @@map("arrival_events")
}

/**
 * ═══════════════════════════ Schedule ═══════════════════════════
 */

/// session  a client's coaching hour — carries the coach's pillar
/// meeting  a meeting WITH a client
/// internal the team's own
/// duty     the daily rhythm: a standing to-do pinned to a nominal hour
enum TaskKind {
  SESSION  @map("session")
  MEETING  @map("meeting")
  INTERNAL @map("internal")
  DUTY     @map("duty")
}

enum RecurFreq {
  NONE   @map("none")
  DAILY  @map("daily")
  ALT    @map("alt")
  WEEKLY @map("weekly")
}

enum TaskRespState {
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  HOLD     @map("hold")
  RESCHED  @map("resched")
}

/// One entry on the team's calendar. A SERIES IS ONE ROW.
///
/// Recurrence expands at READ time — a daily duty is a single row that the grid
/// asks "what do you do on this date". Materialising one row per occurrence would
/// turn "change the whole series" into a migration and "move one day" into a
/// question about which rows were already written.
model Task {
  id    String   @id @default(cuid())
  title String
  kind  TaskKind

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Sessions only: the pillar of the coach's role, and the ONE place a pillar
  /// colour appears on this grid.
  pillar String?

  /// The first occurrence. A series is anchored here and counted from it.
  date     DateTime @db.Date
  /// Minutes from midnight. 07:00-21:00 on a quarter hour — the window the grid
  /// can draw, asserted in the Zod schema rather than by a check constraint so the
  /// message a person reads is written in one place.
  startMin Int
  durMin   Int

  recurFreq  RecurFreq @default(NONE)
  recurUntil DateTime? @db.Date

  /// Named individuals. Declared hours bind THESE people and nobody else.
  assigneeIds String[] @default([])
  /// `g-all | g-ops | ... | g-pod-<clientId>`. Group IDS, never member lists, so
  /// membership stays live: reallocate a pod and its meetings follow.
  groupIds    String[] @default([])

  link  String?
  notes String?

  /// Overlap is OPT-IN and needs BOTH sides. Distinct from a duty's rhythm, which
  /// holds no capacity in either direction.
  allowOverlap Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exceptions TaskException[]
  dones      TaskDone[]
  responses  TaskResponse[]
  proposals  TaskProposal[]

  @@index([date])
  @@index([clientId])
  @@index([kind])
  @@map("tasks")
}

/// One day of a series behaving differently.
///
/// A per-occurrence edit writes one of these rather than detaching the day, so
/// the series stays one row and the change is legible as "this Tuesday only".
model TaskException {
  id     String   @id @default(cuid())
  taskId String
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  cancelled Boolean @default(false)
  startMin  Int?
  durMin    Int?
  title     String?
  link      String?
  notes     String?

  /// `{ fromId, toId }` — how an approved leave cover reaches ONE occurrence. The
  /// grid, the digest, the reminder sweep and the client's plan all read the
  /// occurrence, so a single write moves the name everywhere at once.
  coachSwap Json?
  /// The leave whose approval wrote this swap, so a later change can be traced
  /// back to the decision that made it. Null for an ordinary per-day edit.
  leaveId   String?

  @@unique([taskId, date])
  @@map("task_exceptions")
}

/// Done is a fact about a DATE, not about a task — a daily duty is done on
/// Tuesday and not yet on Wednesday.
model TaskDone {
  id     String   @id @default(cuid())
  taskId String
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  byId String?
  by   User?    @relation("TaskDoneBy", fields: [byId], references: [id], onDelete: SetNull)
  at   DateTime @default(now())

  @@unique([taskId, date])
  @@map("task_dones")
}

/// Where one person stands on a group task.
///
/// Per TASK, not per occurrence: accepting a daily stand-up accepts the standing
/// arrangement, and asking again every morning would make the pill meaningless.
model TaskResponse {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("TaskResponder", fields: [userId], references: [id], onDelete: Cascade)

  state TaskRespState
  at    DateTime      @default(now())

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_responses")
}

/// "Could we do it at four instead?" — a suggestion, not a change.
///
/// Applying one goes through the same move path a drag does, so a proposal cannot
/// land somewhere a drag would have been refused.
model TaskProposal {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  byId String?
  by   User?   @relation("TaskProposer", fields: [byId], references: [id], onDelete: SetNull)

  date     DateTime @db.Date
  startMin Int
  durMin   Int
  note     String?

  createdAt   DateTime  @default(now())
  appliedAt   DateTime?
  appliedById String?
  appliedBy   User?     @relation("TaskProposalApplier", fields: [appliedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_proposals")
}

/**
 * ═══════════════════════════ Team feed ═══════════════════════════
 */

/// General is the default; Policy and Holiday wear their own pill.
enum FeedTag {
  GENERAL @map("general")
  POLICY  @map("policy")
  HOLIDAY @map("holiday")
}

/// An announcement to the STAFF.
///
/// Deliberately not the same thing as an announcement to clients: those need
/// `announceClients` and land in clients' own threads from Community. Two perms,
/// two surfaces, two tables — because the difference is who hears it, and one
/// table with an audience column is one mistaken filter away from telling
/// everybody something meant for the bench.
model TeamPost {
  id   String  @id @default(cuid())
  byId String?
  by   User?   @relation("TeamPostAuthor", fields: [byId], references: [id], onDelete: SetNull)

  tag  FeedTag @default(GENERAL)
  text String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("team_posts")
}

/// How far down the feed one person has read.
///
/// A TIMESTAMP, not a list of post ids — unlike HomeSeen, which has to name the
/// exact rows it saw because its tabs re-order. A feed is strictly newest-first
/// and append-only, so "everything before this moment" is the whole answer and
/// costs one row per person forever.
model TeamFeedRead {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())

  @@map("team_feed_reads")
}

/**
 * ═══════════════════════════ Time & Cover ═══════════════════════════
 */

/// The four steps, plus the two ways out.
///
/// REASSIGN  the cover board has not planned it yet
/// ACCEPT    named covers are being asked; ANY decline returns it to REASSIGN
/// PENDING   every cover agreed; the approver's signature is next
/// APPROVED  covers and session swaps are written
/// DECLINED  refused, with a reason
/// WITHDRAWN the applicant changed their mind before it was decided
enum LeaveStatus {
  REASSIGN
  ACCEPT
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

enum LeaveAct {
  APPLIED
  REASSIGNED
  COVER_ACCEPTED
  COVER_DECLINED
  APPROVED
  DECLINED
  WITHDRAWN
}

enum CoverResponseState {
  PENDING
  ACCEPTED
  DECLINED
}

enum NoticeKind {
  LEAVE
  SLA
  REMINDER
  CELEBRATION
  TASK
}

model Leave {
  id      String @id @default(cuid())
  staffId String
  staff   User   @relation("LeaveApplicant", fields: [staffId], references: [id], onDelete: Cascade)

  /// Inclusive on both ends — a one-day leave has from == to.
  from   DateTime @db.Date
  to     DateTime @db.Date
  reason String

  status        LeaveStatus @default(REASSIGN)
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reallocations LeaveReallocation[]
  sessionCovers LeaveSessionCover[]
  responses     LeaveCoverResponse[]
  events        LeaveEvent[]
  podCovers     PodCover[]

  @@index([staffId])
  @@index([status])
  @@map("leaves")
}

/// One pod seat, and who takes it. Written to PodCover only on APPROVAL.
model LeaveReallocation {
  id      String @id @default(cuid())
  leaveId String
  leave   Leave  @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// The PodSeat key this repo uses — `dietitian`, `fitness`, `yoga`, `mind`, ...
  seatKey  String

  toId String
  to   User   @relation("ReallocationCover", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([leaveId, clientId, seatKey])
  @@map("leave_reallocations")
}

/// One booked occurrence, and who takes it.
///
/// The SEATS alone were not enough: eight of Vikram's appointments sat inside his
/// leave with nothing anywhere saying so, and the client's own plan still named
/// him — a booking wins on "with whom".
model LeaveSessionCover {
  id      String @id @default(cuid())
  leaveId String
  leave   Leave  @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  taskId String
  /// The OCCURRENCE, never the series. A leave covers three days of a daily
  /// session, not the standing arrangement.
  date   DateTime @db.Date

  toId String
  to   User   @relation("SessionCover", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([leaveId, taskId, date])
  @@map("leave_session_covers")
}

/// Where one named cover stands. The accept step is the whole reason this exists.
model LeaveCoverResponse {
  id      String @id @default(cuid())
  leaveId String
  leave   Leave  @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("LeaveCoverResponder", fields: [userId], references: [id], onDelete: Cascade)

  state CoverResponseState @default(PENDING)
  at    DateTime           @default(now())

  @@unique([leaveId, userId])
  @@map("leave_cover_responses")
}

model LeaveEvent {
  id      String   @id @default(cuid())
  leaveId String
  leave   Leave    @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  act     LeaveAct
  byId    String?
  by      User?    @relation("LeaveEventActor", fields: [byId], references: [id], onDelete: SetNull)
  at      DateTime @default(now())

  @@index([leaveId, at])
  @@map("leave_events")
}

/// A dated hand-over of one seat.
///
/// A COVER IS A ROW, NEVER A MUTATION OF PodSeat. The seat keeps its owner and
/// this sits on top of it for a window, so the morning after the window the seat
/// is simply its owner's again — no cleanup job, and nothing to get wrong if one
/// failed to run.
model PodCover {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  seatKey  String

  coverId String
  cover   User   @relation("PodCoverStaff", fields: [coverId], references: [id], onDelete: Cascade)

  from DateTime @db.Date
  to   DateTime @db.Date

  leaveId String?
  leave   Leave?  @relation(fields: [leaveId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([clientId, seatKey, from, to])
  @@map("pod_covers")
}

/// Who signs leave. A singleton the Configuration page will surface later.
model LeaveConfig {
  id           String @id @default("default")
  approverRole String @default("admin")

  updatedAt DateTime @updatedAt

  @@map("leave_config")
}

/// The sweeps' outbox — the port of `HV.notice`.
///
/// WRITE SIDE ONLY for now. Home › Notices reads it later; what matters today is
/// that every notice the leave flow promises is actually recorded, rather than
/// being a toast that vanished with the tab.
model Notice {
  id   String     @id @default(cuid())
  toId String
  to   User       @relation("NoticeRecipient", fields: [toId], references: [id], onDelete: Cascade)
  kind NoticeKind
  text String

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  seenAt    DateTime?

  @@index([toId, createdAt])
  @@map("notices")
}

/**
 * ═══════════════════════════ Configuration ═══════════════════════════
 */

enum ChainKind {
  team
  goalsheet
  diet
  chart
  level
  calendar
  template
}

/// The sequence of signatures an item collects before it publishes — and the LAST
/// signature is what publishes it.
///
/// CHAIN EDITS APPLY TO NEW SUBMISSIONS ONLY. An approval already in flight keeps
/// the chain it started with, because moving the goalposts under a half-signed
/// item would either lose a signature already given or demand one from somebody
/// who was never asked. Approvals snapshot `steps` at creation; `version` is what
/// a snapshot records so a reader can tell which chain an old item walked.
model ApprovalChain {
  kind    ChainKind @id
  /// `[{ role }]`, in order.
  steps   Json      @default("[]")
  version Int       @default(1)

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("approval_chains")
}

enum FlowTrigger {
  ENROL     @map("enrol")
  CYCLE_DAY @map("cycleDay")
}

/// A message sequence a client walks without anybody sending it.
model FlowTemplate {
  id      String      @id @default(cuid())
  name    String
  desc    String?
  trigger FlowTrigger

  /// Whether a NEW client is switched on for it.
  defaultOn Boolean @default(false)
  /// The house switch. Pausing stops it for everybody, however many people have
  /// individually turned it on.
  enabled   Boolean @default(true)
  position  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       FlowStep[]
  clientFlows ClientFlow[]

  @@map("flow_templates")
}

model FlowStep {
  id         String       @id @default(cuid())
  templateId String
  template   FlowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// ENROL: days after joining. CYCLE_DAY: the day of the cycle. Exactly one is
  /// set, decided by the template's trigger — the two read different clocks.
  after Int?
  on    Int?
  /// Minutes from midnight.
  at    Int

  title String
  text  String

  position Int @default(0)

  @@index([templateId, position])
  @@map("flow_steps")
}

/// One client's override of one template.
///
/// THIN ON PURPOSE: a row exists only where somebody has overridden the template's
/// own default. That is what keeps "switched on for 6 of 7" honest without writing
/// a row per client per template every time a template is added — and it is why a
/// changed default moves everybody who never chose.
model ClientFlow {
  id         String       @id @default(cuid())
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId String
  template   FlowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  on Boolean

  updatedAt DateTime @updatedAt

  @@unique([clientId, templateId])
  @@map("client_flows")
}

/// A level book's category — the demo's `tracks`.
///
/// The three SEEDED keys are permanent: `sedentary`, `moderate` and `active` are
/// what every catalog item, template and client already points at, and a key that
/// could be deleted or re-keyed would orphan all three. Renaming is always safe,
/// because the name is only ever displayed.
model CatalogCategory {
  key      String  @id
  name     String
  seeded   Boolean @default(false)
  position Int     @default(0)

  updatedAt DateTime @updatedAt

  @@map("catalog_categories")
}

model CatalogTag {
  id   String @id @default(cuid())
  name String
  /// Lower-cased, so "PCOD" and "pcod" cannot both exist.
  slug String @unique

  position Int @default(0)

  createdAt DateTime @default(now())

  @@map("catalog_tags")
}

/**
 * ═══════════════════════════ Catalog ═══════════════════════════
 */

/// A plan template — the RECIPE built out of the libraries' ingredients.
///
/// One pillar, one level and one activity category, holding one day per day of
/// the cycle. That triple is what makes a template findable: a coach asks for
/// "fitness, level 3, moderate" and gets the fortnight somebody already wrote.
///
/// It is NOT a CatalogItem with a different `kind`. An item is a single thing a
/// coach drops into a day; a template is an arrangement of them across a cycle,
/// and squeezing the second into the first's `body` json would put the whole
/// structure beyond a query.
model PlanTemplate {
  id     String @id @default(cuid())
  name   String
  pillar String
  level  Int
  /// A CatalogCategory key — the shelf this template is written for.
  track  String

  /// `[{ day, items: [catalogItemId] }]`, one entry per day of the cycle. Held as
  /// json because the shape is the cycle's, and the cycle's length is itself
  /// configurable — a table with a row per day would fix what Configuration can
  /// change.
  days Json @default("[]")

  notes String?

  /// THE HOOK for the `template` approval chain, which Configuration already
  /// seeds (Ops Head then Super User). Until the approvals board exists a
  /// template is simply a draft or published; when it lands, publishing becomes
  /// the last signature rather than a flag.
  published Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("TemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pillar, level])
  @@map("plan_templates")
}

/**
 * ═══════════════════════════ Work Queues ═══════════════════════════
 * The six boards of the Queues host, in its own order (console-queues.js:10):
 * work, approvals, meals, medical, deviations, live.
 * What they have in common is a CLOCK. Every row below is something a rule put
 * on one, and the numbers they are read against live in `SlaConfig` — live and
 * unversioned, because a reply target nobody is waiting on is just a number in a
 * table. The one thing here that is NOT live is an approval's chain, and the
 * comment on `Approval.chain` says at length why.
 */

/// The four kinds of row the work list carries (console-ops.js:22).
///
/// Columns rather than words inside `text`, because the demo's chip row filters
/// on them (console-ops.js:63) and a filter over prose is a filter that quietly
/// stops matching the day somebody rewrites a sentence.
enum WorklistType {
  TASK
  RATING
  REVIEW
  REPORT
}

enum WorklistStatus {
  OPEN
  DONE
}

/// One line of somebody's work, generated by a rule.
///
/// The promise printed under the demo's list is "Every task traces to its
/// generating rule" (console-ops.js:104). Nothing here generates rows yet — the
/// seed carries the demo's six — but `type` and `clientId` are what lets a rule's
/// work be found again and cleared when the underlying act is done, which is
/// what `queues.service.rateMeal` does the moment a plate is rated.
model WorklistItem {
  id   String @id @default(cuid())
  text String

  /// WHO OWES IT.
  ///
  /// A work item is addressed to a PERSON, not to a client, and that is why this
  /// one board scopes by owner while the five client boards scope through
  /// `clientScopeWhere`. The demo is explicit (console-ops.js:13): everybody
  /// sees their own rows, `seeAllClients` sees the lot.
  ownerId String
  owner   User   @relation("WorklistOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// The words in the due pill — 'today', '13:00 · 23 min', 'SLA'.
  ///
  /// FREE TEXT because the demo's are, and because those three examples are
  /// against three different clocks. Flattening them onto one DateTime would
  /// force a rule to state a deadline it does not have.
  due  String
  /// How loud the pill is: 'warn' | 'bad' | 'info'. The rule that made the row
  /// decides; the console renders what it is told rather than re-deriving
  /// urgency from a `due` string it cannot interpret.
  pill String

  status WorklistStatus @default(OPEN)

  /// A PILLAR key (fitness / culture / yoga / wellness), or null for the ops
  /// chores that belong to no pillar.
  pillar String?
  type   WorklistType @default(TASK)

  /// Who the work is ABOUT, when it is about somebody.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  doneAt   DateTime?
  doneById String?
  doneBy   User?     @relation("WorklistDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ownerId, status])
  @@index([clientId])
  @@map("worklist_items")
}

/// draft -> submitted (waiting at a stage) -> published.
///
/// A RETURN is not a fourth status: it puts the item back to `draft` with the
/// reason attached, which is the demo's own shape (core.js:1255) and the right
/// one — a returned item is a draft again, in its owner's hands.
enum ApprovalStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

enum ApprovalAct {
  SUBMITTED
  APPROVED
  RETURNED
  PUBLISHED
}

/// One sign-off in the SOP, and the signatures it is collecting.
model Approval {
  id String @id @default(cuid())

  /// The kind of sign-off — WHICH IS ALSO THE CHAIN IT COLLECTS. One enum for
  /// both, so an approval of a type no chain exists for cannot be written.
  type ChainKind

  /// Null for a sign-off about somebody who is not a client yet: a goal sheet or
  /// a team allocation for a prospect (data.js:1645). `prospect` is then the
  /// only name there is, and the board prints it behind a "Prospect" pill.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  prospect String?

  /// The pillar this is about, when it is about one. A calendar spans all four
  /// and carries none (data.js:1619).
  pillar String?
  title  String

  /// Who proposed it. The board prints "Proposed by ..." and the owner is the
  /// only person who may submit or resubmit it.
  ownerId String
  owner   User   @relation("ApprovalOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  status ApprovalStatus @default(DRAFT)
  /// How far down THE SNAPSHOT this has walked. `chain[stage]` is the signature
  /// it is waiting on; `stage >= chain.length` is what publishes it.
  stage  Int            @default(0)

  /// When it is wanted, in the requester's own words ('Day 10 @ 12:00',
  /// '24 h SLA · 9 h left'), for the same reason `WorklistItem.due` is a string.
  due     String
  /// The copilot's proposal. NEVER client-visible, and never a decision — a
  /// human signature is what publishes.
  aiDraft String

  /// Why it came back, kept on the row so the owner sees it on the draft rather
  /// than having to read the trail. Cleared on resubmit.
  returnReason String?

  /// THE CHAIN THIS ITEM WALKS, TAKEN AT CREATION AND NEVER RE-READ.
  ///
  /// `[{ role }]`, copied out of `config.service.getChain(type)` the moment the
  /// approval is created, together with the version that chain was on.
  ///
  /// It is not read again while the item is in flight, and that is the whole
  /// point. If a half-signed item followed the LIVE chain, then removing a step
  /// would throw away a signature somebody has already given, and inserting one
  /// would demand a signature from somebody who was never asked — in both cases
  /// the trail would describe a sequence the item did not walk. Configuration's
  /// own contract says so in as many words (ApprovalChain, above): chain edits
  /// apply to NEW submissions only.
  ///
  /// `chainVersion` is what makes an old item legible. It says which chain this
  /// one collected, so a reader six months later can look it up rather than
  /// guess from the steps alone.
  chain        Json
  chainVersion Int

  history ApprovalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([clientId])
  @@map("approvals")
}

/// One act on an approval — the audit trail the board prints under each card.
///
/// APPEND-ONLY. Nothing here is ever updated: a signature given is a fact, and a
/// return that came after it does not unmake it.
model ApprovalEvent {
  id         String   @id @default(cuid())
  approvalId String
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  act  ApprovalAct
  /// Null only if the actor's account is later deleted — every act here is
  /// somebody's.
  byId String?
  by   User?       @relation("ApprovalEventActor", fields: [byId], references: [id], onDelete: SetNull)
  /// The signer's note, which travels with the trail. A return's reason lands
  /// here too, so the card and the trail cannot disagree about what was said.
  note String?

  at DateTime @default(now())

  @@index([approvalId, at])
  @@map("approval_events")
}

/// A plate, its AI pre-score, and the human rating that is the only thing the
/// client ever sees.
///
/// NO AUTO-PUBLISH, EVER (console-meals.js:2). The AI fields and the final
/// fields are deliberately separate columns rather than one rating with a
/// provenance flag: the board shows the pre-score as a ghost BEHIND the human's
/// choice, and a single column could not hold both at once.
model Meal {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// 'Breakfast' | 'Lunch' | 'Dinner' — the demo's own words, matched by name to
  /// the teaching in MealPlan.
  slot String

  /// THE SLA CLOCK. Everything the meals board says about lateness is minutes
  /// since this instant, read against SlaConfig on every request.
  capturedAt DateTime
  /// What the client said about the plate — 'Just right', 'Light'. Their reading
  /// of it, which is not the coach's and is never overwritten by one.
  fullness   String
  photo      String?
  dishes     String[] @default([])

  /// The pre-score. NEVER CLIENT-VISIBLE: it exists so a dietitian can confirm
  /// it with one tap or override it, and the trail records which of the two
  /// happened.
  aiStars    Int
  aiConf     Int
  aiDetected String[] @default([])
  aiNote     String

  /// The human rating. Null across these columns means the plate is still
  /// waiting, and `finalStars` alone is what the queue tests — a meal is
  /// awaiting review exactly while it has no stars from a person.
  finalStars    Int?
  /// NULL WITH `finalStars` SET MEANS THE AI RATED IT.
  ///
  /// The demo writes `byId: 'u-ai'` for two plates, but `ai` is a pseudo-role and
  /// no such user is ever stored — the same rule `PodSeat.staffId` keeps, where a
  /// null seat means the AI holds it. The alternative is a foreign key to a
  /// person who does not exist, and that is not one.
  finalById     String?
  finalBy       User?     @relation("MealRater", fields: [finalById], references: [id], onDelete: SetNull)
  finalNote     String?
  /// Seconds of recorded voice, 0 when the note was typed. Below five stars the
  /// service requires one or the other — see `queues.service.rateMeal`.
  finalVoiceSec Int?
  ratedAt       DateTime?

  /// The four-line rubric the demo prints on a rated plate. Held as json and
  /// written only by the seed: the demo MANUFACTURES it from the star count at
  /// submit time (console-meals.js:85), so a rating made here leaves it null
  /// rather than recording an assessment nobody actually made.
  rubric Json?

  /// Auto-estimated at capture, editable by the dietitian — the demo's own
  /// words. They feed the calorie log, which is why they are columns and not
  /// part of the AI blob: a number the log adds up has to survive the rating
  /// that confirms it.
  protein Int @default(0)
  kcal    Int @default(0)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([finalStars])
  @@map("meals")
}

enum MedicalStatus {
  PENDING
  READY
}

/// A raw medical document and the structured summary signed off it.
///
/// ONE ROW, TWO AUDIENCES. The raw record renders for `rawRecords` alone; the
/// summary in `body` is what the pod reads and is all anybody else is ever
/// given. Splitting them into two tables was considered and rejected: the
/// pairing IS the rule — a summary exists because a document was read — and two
/// tables would let one exist without the other.
model MedicalSummary {
  id String @id @default(cuid())

  /// Null for a document about somebody who is not a client yet: the demo's one
  /// pending summary is Kiran R.'s blood panel, and Kiran is still an arrival
  /// (data.js:1811). A foreign key to a client row that does not exist is not an
  /// option, so `prospect` carries the name instead.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  prospect String?

  /// The document's own name — 'Blood panel', 'Health panel (HbA1c 7.1)'.
  title      String
  /// 'Lab' | 'InBody' | 'Imaging'. The row prints it beside the upload date.
  kind       String
  /// The demo's upload label, in its words ('12 Oct', 'Today'). A string for the
  /// same reason `due` is one: it is what the document was labelled with, not a
  /// date this system observed.
  uploadedOn String

  status MedicalStatus @default(PENDING)

  /// Who signed, and when. Set together; a summary with one and not the other
  /// would be a signature nobody can date.
  byId     String?
  by       User?     @relation("SummarySigner", fields: [byId], references: [id], onDelete: SetNull)
  signedAt DateTime?

  /// `{ conditions: [], flags: [], metrics: [], history: [...] }`.
  ///
  /// VERSIONED IN PLACE, and the demo is emphatic about why
  /// (console-medical.js:193): "new versions never overwrite priors". Re-signing
  /// pushes the outgoing version into `history` and writes the new one on top,
  /// so the record of what the pod was told last month survives being told
  /// something else this month.
  body Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@map("medical_summaries")
}

/// Something that went off the rails, and where it stands.
///
/// The board's stated target is "-80% deviations cycle-over-cycle", which is a
/// COUNT over time — so these are rows with a timestamp rather than a field on
/// the client. Somebody can deviate twice in a fortnight, and the second one
/// must not overwrite the first.
model Deviation {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// What deviated — 'Non-response (3 d)', 'Meal photo SLA breach'.
  kind  String
  /// Where it stands — 'Ladder step 2 — human call today'.
  state String
  /// Who is handling it: 'Coach' or 'AI'. The demo's own column, and the reading
  /// the whole board exists to move.
  mode  String

  at DateTime @default(now())

  @@index([clientId])
  @@index([at])
  @@map("deviations")
}

/**
 * ═══════════════════════════ Community ═══════════════════════════
 * The commons: the gatherings and challenges people enrol in, the Health Games
 * book, the two canvases of the Haalving Zone, and what the team announces.
 * EVERY TABLE BELOW IS ON ONE SIDE OR THE OTHER OF ONE LINE, and the line is the
 * whole design (console-community.js:24):
 * CONTENT       what a gathering IS — its title, when, where, its agenda. The
 * console owns it, `manageTribe` writes it.
 * MEMBER STATE  whether a person is going, has joined, has answered, has liked.
 * The console READS it for a count pill and has never written it;
 * the client apps write it, and nothing here offers a way to.
 * The demo keeps both inside one object per item — `going: false` sits beside
 * `title` — which works in a single browser holding one person's copy of the
 * world. A server holds everybody's, so member state becomes its own row per
 * person. That is also what makes it impossible for a console edit to touch it by
 * accident, which the demo has to achieve by carefully overwriting content keys
 * only and re-seeding the rest by hand.
 * ANNOUNCEMENTS ARE NOT PART OF THAT LINE. They are the one OUTBOUND surface:
 * they write nothing on this page and push a card into many clients' own Care
 * Circles instead. They need `announceClients`, which is a DIFFERENT permission
 * from `manageTribe` and deliberately not the older `broadcast` — that one means
 * the STAFF feed in People & Access and must not be widened into a licence to
 * message every client on the platform (console-community.js:17; the reason is
 * written out in PERM_LABELS, shared/people.ts:17).
 */

/// Who is in the commons.
///
/// The demo's `tribeFeed.circle` — a flat list of the clients who share this
/// community. It is a table rather than "every active client" because it is not
/// that: two seeded clients have no login at all, and a person can be a client of
/// HAALVING without being in the room.
///
/// CLIENTS, not users. Membership is a client fact — you are here because you are
/// on a plan. Authorship is a user fact, which is why every author column in this
/// module points at User instead: the house account, a staff member and a client
/// can all write, and only one of the three has a Client row.
model CommunityMember {
  clientId String @id
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@map("community_members")
}

/// A gathering — the demo's `events`. CONTENT.
model Gathering {
  id    String  @id @default(cuid())
  title String
  /// 'Sat · 7:30 AM'. FREE TEXT, like the demo's, and for the same reason its
  /// game days keep '3 Aug': the client page prints this line as written. A
  /// DateTime would force every gathering to name a year and a timezone nobody
  /// who typed "Next Sat" was thinking about.
  when  String  @default("")
  where String  @default("")
  host  String?
  /// '24 places · kept small on purpose' — a sentence, not a number. Nothing
  /// counts against it, and an integer would imply a capacity rule this product
  /// does not have.
  spots String?
  desc  String  @default("")

  /// The long-read paragraphs, one per element.
  about  String[] @default([])
  /// The day, one stop per element: `[{ t: '5:30 AM', v: 'Assemble ...' }]`.
  /// JSON rather than its own table because it is a LIST READ WHOLE — nothing
  /// queries a single stop, and a table would buy joins for nothing.
  agenda Json     @default("[]")
  bring  String[] @default([])

  /// Always a real photograph: it is read at full width in the client's Events
  /// face, where a cut-out specimen plate would show its ground.
  img String

  /// Newest first — and `position` rather than `createdAt`, because the console
  /// UNSHIFTS. A new gathering takes `min - 1` and lands at the top, which a
  /// creation timestamp cannot express when three are seeded in one instant.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Who proposed it. Nullable because the demo's own three predate the field,
  /// and SetNull rather than Cascade: a gathering outlives whoever wrote it.
  createdById  String?
  createdBy    User?     @relation("GatheringCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// THE GATE, modelled as a timestamp rather than an enum.
  ///
  ///   approved = `approvedAt` is set
  ///   returned = no `approvedAt`, but a `returnNote`
  ///   pending  = neither
  ///
  /// The same shape `TaskProposal.appliedAt` and `Meal.finalStars` already use,
  /// and it needs no CREATE TYPE — one fewer thing for a migration to trip on.
  approvedById String?
  approvedBy   User?     @relation("GatheringApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  /// Why it came back. Set on a return, cleared on approval.
  returnNote   String?

  enrolments GatheringEnrolment[]

  @@index([approvedAt])
  @@index([position])
  @@map("gatherings")
}

/// MEMBER STATE. One row per client who is going — the demo's `going: true`.
model GatheringEnrolment {
  gatheringId String
  gathering   Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  @@id([gatheringId, clientId])
  @@index([clientId])
  @@map("gathering_enrolments")
}

/// A standing challenge. CONTENT.
model Challenge {
  id    String  @id @default(cuid())
  title String
  /// How long it runs. A NUMBER, where a gathering's `when` is prose, because the
  /// client's ring counts against it — this one is arithmetic.
  days  Int
  host  String?
  stake String?
  desc  String  @default("")

  about String[] @default([])
  how   String[] @default([])
  /// How the days go: `[{ k: 'Days 1–3', v: 'Finding the slot' }]`.
  arc   Json     @default("[]")

  img String

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries ChallengeEntry[]

  @@index([position])
  @@map("challenges")
}

/// MEMBER STATE — the demo's `joined: true`.
model ChallengeEntry {
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  @@id([challengeId, clientId])
  @@index([clientId])
  @@map("challenge_entries")
}

/// One day of the Health Games book. CONTENT.
model GameDay {
  id    String @id @default(cuid())
  /// 'Mon'.
  label String
  /// '3 Aug' — free text, for the reason `Gathering.when` gives.
  date  String @default("")

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions GameQuestion[]

  @@index([position])
  @@map("game_days")
}

/// One question. ITS OWN TABLE, not a JSON array on the day, for exactly one
/// reason: AN ANSWER HAS TO POINT AT SOMETHING. A client's answer is member state
/// and outlives every edit; a question inside a JSON array has no identity to
/// point at, so rewriting the day would silently re-address answers already
/// given.
model GameQuestion {
  id        String  @id @default(cuid())
  gameDayId String
  gameDay   GameDay @relation(fields: [gameDayId], references: [id], onDelete: Cascade)

  /// Where it sits in the day. The console edits a day WHOLE and rewrites its
  /// questions by position, so this is the address an answer survives an edit by.
  position Int

  prompt  String
  options String[]
  /// The index into `options` that is right. Checked against the options' own
  /// length when it is written — the console's sheet does `Number(v) || 0` with
  /// no bound, so a typed 7 against three options makes a question nobody can get
  /// right.
  answer  Int
  why     String   @default("")

  answers GameAnswer[]

  @@unique([gameDayId, position])
  @@map("game_questions")
}

/// MEMBER STATE — the demo's `answered`.
///
/// In the demo `answered` is a field ON the question, because that store belongs
/// to one person. Here it is a row per person, which is why the console's "3 of 5
/// answered" pill has to become "3 of 5 questions ANYBODY has answered": the same
/// sentence cannot mean the same thing once there is more than one reader.
model GameAnswer {
  questionId String
  question   GameQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Which option they chose. Whether it was RIGHT is `chose == question.answer`
  /// and is never stored: a stored verdict would survive a corrected answer key.
  chose Int

  at DateTime @default(now())

  @@id([questionId, clientId])
  @@index([clientId])
  @@map("game_answers")
}

/// A private space members keep on the Haalving Zone.
///
/// WhatsApp-shaped in the making (pick people, then name it), Instagram-shaped in
/// the living (a private canvas only its members see).
model Zone {
  id   String @id @default(cuid())
  name String

  /// Who made it. NULL means the HOUSE ACCOUNT — a console-made zone is
  /// HAALVING's and never the acting admin's, because this console has never
  /// posted as a client and does not start by minting a space in one's name
  /// (console-community.js:679). Null makes the same statement `Meal.finalById`
  /// and `PodSeat.staffId` make: the actor is not a person with a user row.
  createdById String?
  createdBy   User?   @relation("ZoneCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ZoneMember[]
  posts   CommunityPost[]

  @@index([position])
  @@map("zones")
}

/// Who is in a zone.
///
/// The console MAY write this one — full admin here was a deliberate choice
/// (console-community.js:672) — which makes it the single membership table this
/// module's routes can change. What is SAID inside a zone still belongs to the
/// people in it: removing somebody does not remove what they wrote.
model ZoneMember {
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  @@id([zoneId, clientId])
  @@index([clientId])
  @@map("zone_members")
}

/// What a post is: a line, a photograph, a short film, or a game.
enum PostKind {
  TEXT
  PHOTO
  SHORT
  QUIZ
}

/// One post on a canvas.
///
/// ONE TABLE FOR BOTH CANVASES, told apart by `zoneId`: null is the Common
/// Canvas every member sees, a value is that zone's private one. The demo keeps
/// two arrays of the identical shape; one table with a nullable owner says the
/// same fact once, and it is what makes "deleting a zone deletes the posts its
/// members wrote in it" a cascade rather than a loop somebody has to remember.
model CommunityPost {
  id String @id @default(cuid())

  /// Null = the Common Canvas.
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  /// WHO WROTE IT. Null means the HOUSE ACCOUNT — see `Zone.createdById`.
  authorId String?
  author   User?   @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// WHO IT IS ABOUT — the client whose words these are, when a client wrote it.
  ///
  /// This is the column the staff-side SCOPE reads, and it is a column rather
  /// than a hop through `author` on every read for a reason the sibling module
  /// learnt the expensive way: a scope expressed as a filter through a NULLABLE
  /// relation inside an OR collapses to the other branch (the fix is written up
  /// on `queues.service.approvalScope`). One indexed column, resolved once when
  /// the post is written, cannot.
  ///
  /// Null for a house post and for a staff-authored one — they are about nobody,
  /// and every scope in this module lets those through.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind    PostKind @default(TEXT)
  caption String   @default("")

  /// The media. Untouched by an edit from this console: a photograph or a game
  /// keeps what it carries when its caption is corrected.
  img  String?
  /// Seconds of a short film.
  secs Int?
  /// A game post's payload: `{ q, opts, ans, why }`. JSON because it is read
  /// whole and answered in the client app, and never queried.
  quiz Json?

  /// MODERATION — the third category, beside content and member state: staff
  /// action on somebody else's words. Both flags are properties of the COMMON
  /// CANVAS. Hiding takes a post off it for everyone else while its author still
  /// sees it on My Canvas, marked hidden: we do not remove people's words
  /// quietly, and hiding is reversible and is not a delete.
  ///
  /// At most one post is pinned, and that is enforced on the WRITE rather than
  /// merely made unlikely — the client sorts pinned-first, so a second pin would
  /// make that order arbitrary.
  pinned Boolean @default(false)
  hidden Boolean @default(false)

  postedAt DateTime @default(now())

  likes    PostLike[]
  comments PostComment[]

  @@index([zoneId, postedAt])
  @@index([clientId])
  @@index([pinned])
  @@map("community_posts")
}

/// MEMBER STATE. A like is a client's, never a staff member's — the console
/// counts them and has no way to add one.
model PostLike {
  postId   String
  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  clientId String
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  @@id([postId, clientId])
  @@index([clientId])
  @@map("post_likes")
}

/// MEMBER STATE. A reply under a post.
model PostComment {
  id     String        @id @default(cuid())
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// The author as a USER, for the reason `CommunityPost.authorId` is one.
  byId     String?
  by       User?   @relation("PostCommentAuthor", fields: [byId], references: [id], onDelete: SetNull)
  /// And the client it belongs to when a client wrote it, so a comment carries
  /// the same scope its post does.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  text String

  /// The demo authors no time on a comment at all. The column exists because a
  /// thread needs an ORDER, which is the one thing a reply cannot do without.
  at DateTime @default(now())

  @@index([postId, at])
  @@index([clientId])
  @@map("post_comments")
}

/// Marketing, or operations. The difference is a promise to the client: an
/// ANNOUNCEMENT may be silenced, a NOTICE always delivers.
enum BroadcastKind {
  ANNOUNCEMENT
  NOTICE
}

/// How an audience was chosen. ONE MODE, never combined — which is what keeps the
/// recipient count unambiguous and the composer a radio group (core.js:1123).
enum AudienceMode {
  ALL
  PLAN
  COACH
  PICK
}

/// A client who has switched announcements OFF.
///
/// A THIN OVERRIDE TABLE, the shape `ClientFlow` already uses: a row exists only
/// where somebody chose, and absence means ON. That is the demo's own contract
/// ("default ON: a client record added later needs no migration", core.js:1116),
/// and it is why this is not a boolean column with a default — a column has to be
/// back-filled for every client that ever exists, and the day that is missed
/// somebody quietly stops receiving post.
model ClientAnnouncePref {
  clientId String  @id
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  on       Boolean

  updatedAt DateTime @updatedAt

  @@map("client_announce_prefs")
}

/// One announcement, and what it actually reached.
model Broadcast {
  id String @id @default(cuid())

  /// The REAL sender, never a literal house id. The client's renderer prints
  /// HAALVING regardless, because an offer is the organisation speaking rather
  /// than a person — but the record keeps honest attribution, because somebody
  /// has to be answerable for it.
  byId String
  by   User   @relation("BroadcastSender", fields: [byId], references: [id], onDelete: Cascade)

  kind  BroadcastKind
  title String        @default("")
  text  String
  img   String        @default("")

  /// A deep link into the client's Community, or null: `{ href, label }`. The
  /// composer offers a fixed menu built from the content that actually exists, so
  /// this can never point at a gathering somebody deleted last week.
  link Json?

  /// The spec as chosen: `{ mode, plans, staffIds, clientIds }`.
  audience      Json
  /// And the sentence the operator read before agreeing — 'Every client',
  /// "Sneha's clients", '3 hand-picked'. STORED rather than re-derived, because a
  /// coach who leaves or a plan that is withdrawn would otherwise rewrite the
  /// description of a send that already happened.
  audienceLabel String

  /// THE REACH, STAMPED AND NEVER RECALCULATED. A client flipping their switch
  /// next week must not be able to rewrite what this send did. `delivered` means
  /// the card is genuinely sitting in that thread, and it can mean that because
  /// opted-out clients are filtered at SEND time rather than at render time — a
  /// message delivered-then-hidden would still take a `seq` and light an unread
  /// dot for something nobody can ever open (core.js:1110).
  targeted  Int
  delivered Int
  muted     Int

  sentAt DateTime @default(now())

  deliveries BroadcastDelivery[]

  @@index([sentAt])
  @@map("broadcasts")
}

/// One card, in one client's room.
///
/// The join table IS the reach log. The demo stamps an array of client ids; a row
/// per delivery says the same thing and also names the message it became — which
/// is what makes "delivered" checkable rather than asserted, and what lets a
/// re-seed find its own output again and clear only that.
model BroadcastDelivery {
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// The card in their Care Circle. Null only once that message has been removed.
  messageId String?        @unique
  message   CircleMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  at DateTime @default(now())

  @@id([broadcastId, clientId])
  @@index([clientId])
  @@map("broadcast_deliveries")
}
